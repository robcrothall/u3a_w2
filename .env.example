# Copy this file to .env (outside git) and fill in real values.
# .env itself must NEVER be committed - it's in .gitignore.
#
# On the live server, .env lives in the FTP account's home directory,
# alongside (but not inside) public_html, so it's never web-accessible.
# During local dev with Laragon, it lives at the repo root.

APP_ENV=production
APP_DEBUG=false

DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASS=

# AES key/IV used for PoPI-sensitive fields (sensitive_text table).
# Generate real random values - do not reuse the old hardcoded ones.
ENCRYPTION_KEY=
ENCRYPTION_IV=

SITE_URL=https://u3aportalfred.org.za
HELPDESK_EMAIL=rob@crothall.co.za
